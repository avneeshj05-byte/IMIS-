# IMIS Environment Configuration Template
PROJECT_NAME="INDUSTRIAL MAINTENANCE INTELLIGENCE SYSTEM (IMIS)"
PROJECT_TAGLINE="Intelligent Diagnostics. Predictive Maintenance. Operational Reliability."
VERSION="1.0.0"

# LLM Provider Configuration: GEMINI, OPENAI, HUGGINGFACE, or LOCAL_GROUNDED
LLM_PROVIDER="GEMINI"
LLM_MODEL_NAME="gemini-1.5-flash"

# Cloud Inference API Keys (Leave blank for zero-dependency Local Grounded Rule Synthesizer)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
HUGGINGFACE_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Database Configuration
DATABASE_URL="sqlite:///./imis.db"

# RAG & Embeddings
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.15

# ML & Simulation
SIMULATION_INTERVAL_SEC=2.0
ISOLATION_FOREST_CONTAMINATION=0.05
